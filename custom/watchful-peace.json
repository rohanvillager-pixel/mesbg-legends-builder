{
  "name": "The Watchful Peace",
  "version": "1.0",
  "toggle": {
    "property": "watchfulPeace",
    "label": "The Watchful Peace",
    "default": false
  },
  "badge": "TWP",
  "source": "The Watchful Peace fan-made sourcebook, 2025",
  "magicalPowers": [
    {
      "name": "Fury (Dunland)",
      "duration": "Exhaustion",
      "definition": "This Magical Power targets the caster. Friendly Dunland models within 6\" of the caster automatically pass any Courage Tests they are required to take."
    }
  ],
  "keywords": [
    {
      "name": "Royal Banner of Annúminas",
      "tag": "Passive",
      "definition": "This is a Unique banner with a range of 3\". Tarvegil does not suffer the -1 penalty to his Duel Roll for carrying a banner. Additionally, friendly Arnor models (including Tarvegil) within 3\" gain the Dominant (2) special rule."
    },
    {
      "name": "Desperate Fighter",
      "tag": "Passive",
      "definition": "If this model is outnumbered in a Fight (including spear and pike support) and wins the ensuing Duel Roll, it may re-roll results of a natural 1 To Wound when making Strikes."
    },
    {
      "name": "Swift Riders, Stalking in Shade",
      "tag": "Passive",
      "definition": "This model benefits from the effects of its Elven cloak even while it has the Cavalry keyword."
    },
    {
      "name": "Light Chariot",
      "tag": "Passive",
      "definition": "When this model moves using Chariot Charge, it inflicts two Strength 4 hits."
    },
    {
      "name": "Vengeance",
      "tag": "Passive",
      "definition": "At the beginning of the Move phase, if Frumgar has an enemy Orc model within charge distance, he must charge one such model whenever possible. Frumgar also has Hatred (Orc)."
    },
    {
      "name": "First Spear",
      "tag": "Passive",
      "definition": "Whenever Frumgar charges while he has the Cavalry keyword, he counts as a banner for Éothéod models within 3\"."
    },
    {
      "name": "Heir of Rhovanion",
      "tag": "Passive",
      "definition": "Whilst mounted, this model may re-roll failed Jump and Swim tests."
    },
    {
      "name": "Do Not Come Close",
      "tag": "Passive",
      "definition": "No friendly Warrior models may use any of the Headsman's Heroic Actions or Stand Fast!"
    },
    {
      "name": "The Maddening Voices",
      "tag": "Passive",
      "definition": "Whenever the Headsman kills a model, he gains Terror for the rest of the game. Before Priority in each following turn, roll a D6. On a 1, the opposing player may make the Headsman charge any friendly or enemy model within 6\". Resolve the move before Priority. If it is a friendly model, the Headsman may Strike normally but the friendly model may not Strike him."
    },
    {
      "name": "Scaled Cloaks",
      "tag": "Passive",
      "definition": "If this model is shot and wounded by a missile weapon of Strength 3 or less, roll a D6. On a 6+, the Wound is ignored."
    },
    {
      "name": "The Voice of the Shaman",
      "tag": "Active",
      "definition": "The Eater of Dreams' Stand Fast! has a range of 12\"."
    },
    {
      "name": "Subjugated",
      "tag": "Passive",
      "definition": "If the Eater of Dreams is removed from the battlefield or moves more than 30\" from Kranak, knock all models within 1\" of Kranak 1\" away and make them Prone. Both players roll a D6; the higher roller controls Kranak for the rest of the turn, with ties won by Kranak's original owner. Repeat the roll at the start of each subsequent Priority phase."
    },
    {
      "name": "One of a Kind (Kranak)",
      "tag": "Passive",
      "definition": "Only one Kranak may be included in an Army, despite Kranak not being a Hero."
    },
    {
      "name": "Trample (Fuinur's Mûmak)",
      "tag": "Active",
      "definition": "When Fuinur's Mûmak Tramples, it inflicts four Strength 9 impact hits."
    },
    {
      "name": "Gifted War Beast of Far Harad",
      "tag": "Passive",
      "definition": "Fuinur is a Beastmaster riding a Mûmak with Tusk Weapons and Sigils of Defiance. The Mûmak has no howdah."
    }
  ],
